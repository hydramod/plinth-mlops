# LF in the repo and LF on checkout, on every platform.
#
# Not cosmetic: anything executed by bash breaks if Git checks it out with CRLF on
# Windows - the carriage returns are read as part of each command, and it fails with
# errors that look nothing like the actual cause.
* text=auto eol=lf

# Never touch these.
*.png binary
*.jpg binary
*.gz  binary
*.tfstate binary
